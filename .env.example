# Copia este fichero como .env y rellena los valores reales.
# .env NUNCA se sube a git (ver .gitignore).

# Recurso único de Azure AI Foundry (noba-locations-resource, kind AIServices).
# Misma key para las dos APIs de abajo; el HOST cambia según la API
# (esto es distinto del "Project endpoint" que se ve en el overview
# del proyecto en ai.azure.com — ese es para el SDK de agentes, no para
# estas llamadas REST directas).
AZURE_AI_KEY=

# --- Azure OpenAI: chat con visión (genera la descripción de la localización) ---
# Overview del proyecto en ai.azure.com -> "Azure OpenAI endpoint"
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Azure Vision: multimodal embeddings v4.0 (vectoriza cada foto) ---
# El recurso (no el proyecto) -> Resource Management -> Keys and Endpoint -> Endpoint
AZURE_VISION_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com
AZURE_VISION_API_VERSION=2024-02-01
AZURE_VISION_MODEL_VERSION=2023-04-15
